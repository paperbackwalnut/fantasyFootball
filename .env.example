# Generate a long random value and paste the same value into the Chrome extension popup.
ESPN_SYNC_TOKEN=
# Optional override; defaults to .data/fantasy-football.sqlite.
LOCAL_DB_PATH=.data/fantasy-football.sqlite
# Optional: provide a base64-encoded 32-byte key instead of the generated .data/credential.key file.
LOCAL_CREDENTIAL_KEY=
# Optional location for the generated raw 32-byte key file.
LOCAL_CREDENTIAL_KEY_PATH=.data/credential.key
