{
	"name": "fantasyfootball",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --host 127.0.0.1",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:sync": "node --test src/lib/server/espn-sync/draft-state.test.js src/lib/server/espn-sync/league-context.test.js src/lib/server/db/secrets.test.js src/lib/server/player-sources/csv.test.js src/lib/server/player-sources/adp.test.js src/lib/server/recommendations.test.js src/lib/server/draft-market.test.js",
		"test:db-security": "node scripts/verify-local-security.mjs",
		"replay:sync": "node scripts/replay-espn-capture.mjs",
		"postmortem:draft": "node scripts/draft-postmortem.mjs"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-auto": "^6.0.0",
		"@sveltejs/kit": "^2.22.0",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@tailwindcss/vite": "^4.0.0",
		"@types/better-sqlite3": "^9.6.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^7.0.4"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"better-sqlite3",
			"esbuild"
		]
	},
	"dependencies": {
		"better-sqlite3": "12.11.1",
		"espn-fantasy-football-api": "^2.0.1",
		"uuid": "^11.1.0"
	}
}
